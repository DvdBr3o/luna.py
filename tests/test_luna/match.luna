MismatchError:
    to_string: self -> "none of branches matched!"
    create: _ ->
        [meta]: MismatchError
    [meta].create: self -> self.create nil

else: {}

MatchType: { tag: "MatchType" }

type: mta ->
    [meta]: MatchType
    typ: mta

match: x -> cands ->
    (cands .Table.fold {false, (MismatchError.create nil)} {matched, init} -> k -> v ->
        (matched === false) .if (
            (k[meta] === MatchType) .if (
                (k.typ == x[meta]) .if {true, (
                    ((decltype v) == "Closure") .and (_ -> v x) .or v
                )} {false, init}
            ) ((k === else) .if {true, v} (
                (k == x) .if {true, (
                    ((decltype v) == "Closure") .and (_ -> v x) .or v
                )} {false, init}
            ))
        ) (
            {true, init}
        )
    ).2
